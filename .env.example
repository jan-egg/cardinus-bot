# Cardinus Bot - Environment Configuration
# Copy this file to .env and fill in your bot token

# Discord Bot Token
# Get your token from: https://discord.com/developers/applications
BOT_TOKEN=

# Optional: test server for immediate slash-command updates; leave blank for global commands.
GUILD_ID=

# Optional: YouTube OAuth refresh token for videos requiring sign-in.
YOUTUBE_OAUTH_REFRESH_TOKEN=

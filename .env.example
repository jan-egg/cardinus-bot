DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
LAVALINK_PASSWORD=replace-with-a-random-local-password
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333

# YouTube sign-in. Leave empty on the first run, then paste the refresh token
# Lavalink prints after you complete the device login (see README).
YOUTUBE_REFRESH_TOKEN=

# Optional: Spotify links and search (https://developer.spotify.com/dashboard).
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# D&D knowledge base. RAG_API_KEY protects the upload/query API.
RAG_API_KEY=replace-with-another-random-password
OLLAMA_MODEL=llama3.1:8b
# Use Ollama installed on Windows instead of the container:
# OLLAMA_URL=http://host.docker.internal:11434
